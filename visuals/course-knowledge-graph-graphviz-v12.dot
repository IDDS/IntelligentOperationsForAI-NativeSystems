digraph CourseGraph {
  graph [
    rankdir=LR,
    bgcolor="#071126",
    pad="0.22",
    nodesep="0.36",
    ranksep="0.82",
    splines=polyline,
    overlap=false,
    concentrate=false,
    compound=true,
    newrank=true,
    fontname="PingFang SC",
    fontcolor="#DCE7FF",
    labelloc=t,
    label="面向 AI 原生系统的智能运维 · 课程实体关系图\n17 周课程：概念 → 方法 → 观测证据 → 诊断 → Agent 治理 → 验证与知识沉淀\n读图：每个知识域回答一个运维问题；每条边表示先修、实现、观测、诊断、治理、验证或反馈关系\n课程资料仓库：github.com/IDDS/-IntelligentOperationsForAI-NativeSystems",
    fontsize=28
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="PingFang SC",
    fontsize=17,
    margin="0.16,0.10",
    color="#77A4FF",
    fontcolor="#E8F0FF",
    penwidth=1.7
  ];
  edge [
    fontname="PingFang SC",
    fontsize=13,
    fontcolor="#BED1F4",
    color="#77A4FF",
    penwidth=1.8,
    arrowsize=0.75
  ];

  subgraph cluster_d1 {
    label="D1  AI 原生系统基础 · W01–02\n回答：系统有什么对象，什么算作故障？";
    color="#38568F"; fontcolor="#9CB8FF"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d1a [label="AI 原生系统\n模型 · 数据 · 服务 · Agent\n定义运维对象和边界", fillcolor="#102650"];
    d1b [label="训练与推理生命周期\n并行 · 调度 · 质量\n理解故障传播的阶段", fillcolor="#102650"];
    d1c [label="故障语言与 SLO\n性能 · 成本 · 安全 · 漂移\n把“坏”变成可测目标", fillcolor="#102650"];
    d1d [label="RAG / Prompt / 多智能体\n工具 · 记忆 · 协作\n扩展 AI 系统的状态空间", fillcolor="#102650"];
  }

  subgraph cluster_d2 {
    label="D2  可观测性与证据底座 · W03–05\n回答：从哪里取得可解释、可关联的证据？";
    color="#277C78"; fontcolor="#72E0C1"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d2a [label="Metrics / Logs / Traces\n指标 · 日志 · 调用链\n建立多源证据底座", fillcolor="#103C36", color="#55D3A8"];
    d2b [label="OTel / Langfuse\n上下文传播 · GenAI 观测\n把一次请求串成调用链", fillcolor="#103C36", color="#55D3A8"];
    d2c [label="Token / TTFT / TPOT\n质量 · 成本 · 用户体验\n连接用户结果与运行时", fillcolor="#103C36", color="#55D3A8"];
    d2d [label="GPU / Kernel / Network\n跨层 Profiling 证据\n必要时下钻到硬件路径", fillcolor="#103C36", color="#55D3A8"];
  }

  subgraph cluster_d3 {
    label="D3  异常感知与候选定位 · W06–07\n回答：何时算异常，先检查哪个故障域？";
    color="#A57B1C"; fontcolor="#F6C35E"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d3a [label="异常检测\n统计 · ML · 深度模型\n从正常基线提取异常信号", fillcolor="#3B2A12", color="#F6B13B"];
    d3b [label="告警压缩与归并\n去重 · 聚合 · 风暴抑制\n把噪声变成事件候选", fillcolor="#3B2A12", color="#F6B13B"];
    d3c [label="候选故障域\n服务 · 变更 · 资源 · 网络\n先排序，再决定下钻成本", fillcolor="#3B2A12", color="#F6B13B"];
    d3d [label="调用链剪枝 / HotSpot\nMicroRank · ChangeRCA\n缩小影响路径和变更范围", fillcolor="#3B2A12", color="#F6B13B"];
  }

  subgraph cluster_d4 {
    label="D4  因果诊断与 RCA 推理 · W08\n回答：如何从相关性走向可验证的根因？";
    color="#A53D58"; fontcolor="#FF9FB4"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d4a [label="RCA 假设\n对象 · 时间 · 影响范围\n明确调查问题和停止条件", fillcolor="#40202B", color="#FF7896"];
    d4b [label="因果图 / SCM\n相关 · 时间 · 结构\n区分症状、原因和中介", fillcolor="#40202B", color="#FF7896"];
    d4c [label="反事实与干预验证\n反证 · 对照 · 置信度\n要求结论可以被推翻", fillcolor="#40202B", color="#FF7896"];
    d4d [label="论文方法锚点\nTELLER · CauseLens · LLMRCA\n用研究结果比较方法边界", fillcolor="#40202B", color="#FF7896"];
  }

  subgraph cluster_d5 {
    label="D5  Agent 化运维执行 · W09–10、W13–14\n回答：谁来调查、谁来行动，怎样保证安全？";
    color="#7655B7"; fontcolor="#C7B5FF"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d5a [label="ReAct 调查循环\n思考 · 查询 · 观察\n让 Agent 用证据更新假设", fillcolor="#2B2352", color="#A68CFF"];
    d5b [label="工具 / MCP / Schema\n权限 · 预算 · 停止条件\n把行动约束写进契约", fillcolor="#2B2352", color="#A68CFF"];
    d5c [label="多智能体协作\n分工 · 消息契约 · 记忆\n把复杂调查拆成角色", fillcolor="#2B2352", color="#A68CFF"];
    d5d [label="Workflow / HITL / Rollback\nStateFlow · TapeAgents\n让执行可审批、可回滚", fillcolor="#2B2352", color="#A68CFF"];
  }

  subgraph cluster_d6 {
    label="D6  LLM Serving 与全栈治理 · W11–12、W15\n回答：如何把诊断动作安全地落到生产平台？";
    color="#8054B3"; fontcolor="#D0B8FF"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d6a [label="LLM Serving\nvLLM · PagedAttention · DistServe\n把模型变成可运营服务", fillcolor="#211E4B", color="#C5A4FF"];
    d6b [label="Prefill / Decode / KV Cache\n连续批处理 · P/D 解耦\n解释 TTFT/TPOT 的运行时来源", fillcolor="#211E4B", color="#C5A4FF"];
    d6c [label="GPU Kernel / NCCL / Network\nProfiling · collective · path\n定位跨设备和跨网络瓶颈", fillcolor="#211E4B", color="#C5A4FF"];
    d6d [label="控制面 / 数据面 / 安全\n对象 · 权限 · 成本 · Guardrail\n把治理策略接入平台边界", fillcolor="#211E4B", color="#C5A4FF"];
    d6e [label="Chaos / Oracle / Replay\n故障注入 · 反例回放\n在执行前验证风险", fillcolor="#211E4B", color="#C5A4FF"];
  }

  subgraph cluster_d7 {
    label="D7  事件记忆与知识闭环 · W15–17\n回答：如何把一次调查变成下一次可复用的知识？";
    color="#278AA0"; fontcolor="#8FEAF4"; penwidth=1.4; style="rounded,dashed";
    rank=same;
    d7a [label="Canonical Object / Event\n对象 · 事件 · 时间线\n统一调查的查询入口", fillcolor="#103C48", color="#5CD6E6"];
    d7b [label="Episode / Event Memory\n历史条件 · 处置经验\n保留上下文而非只存摘要", fillcolor="#103C48", color="#5CD6E6"];
    d7c [label="评测 / Oracle / 回放\n结果 · 边界 · 可复现\n判断动作是否真的有效", fillcolor="#103C48", color="#5CD6E6"];
    d7d [label="运维知识图谱\n实体 · 关系 · 证据来源\n让经验可以被查询和组合", fillcolor="#103C48", color="#5CD6E6"];
    d7e [label="反馈与持续改进\n更新规则 · 记忆 · 策略\n把结果反馈到下一轮运维", fillcolor="#103C48", color="#5CD6E6"];
  }

  // Main teaching spine. These labels are intentionally sparse so arrows remain legible.
  d1a -> d2a [label="观测", color="#77A4FF", penwidth=2.7];
  d2a -> d3a [label="检测", color="#55D3A8", penwidth=2.7];
  d3c -> d4a [label="定位 / 诊断", color="#F6B13B", penwidth=2.7];
  d4c -> d5a [label="治理", color="#FF7896", penwidth=2.7];
  d5d -> d6a [label="执行", color="#A68CFF", penwidth=2.7];
  d6e -> d7c [label="验证", color="#5CD6E6", penwidth=2.7];
  d7e -> d1c [label="反馈 / 修正", color="#5CD6E6", penwidth=2.2, style=dashed, constraint=false];

  // Within-domain teaching dependencies.
  d1a -> d1b [label="先修", color="#77A4FF"];
  d1b -> d1c [color="#77A4FF"];
  d1b -> d1d [color="#77A4FF"];

  d2a -> d2b [color="#55D3A8"];
  d2b -> d2c [color="#55D3A8"];
  d2b -> d2d [color="#55D3A8"];

  d3a -> d3b [color="#F6B13B"];
  d3b -> d3c [color="#F6B13B"];
  d3c -> d3d [color="#F6B13B"];

  d4a -> d4b [color="#FF7896"];
  d4b -> d4c [color="#FF7896"];
  d4c -> d4d [label="案例", color="#FF7896", style=dashed];

  d5a -> d5b [color="#A68CFF"];
  d5b -> d5c [color="#A68CFF"];
  d5c -> d5d [color="#A68CFF"];

  d6a -> d6b [color="#C5A4FF"];
  d6b -> d6c [color="#C5A4FF"];
  d6c -> d6d [color="#C5A4FF"];
  d6d -> d6e [color="#C5A4FF"];

  d7a -> d7b [color="#5CD6E6"];
  d7b -> d7c [color="#5CD6E6"];
  d7c -> d7d [color="#5CD6E6"];
  d7d -> d7e [color="#5CD6E6"];

  // Cross-domain relationships.
  d1b -> d2c [label="产生证据", color="#55D3A8"];
  d2c -> d3a [label="触发", color="#55D3A8"];
  d2d -> d3c [label="定位线索", color="#55D3A8"];
  d3d -> d4b [label="候选排序", color="#F6B13B"];
  d4d -> d5b [label="工具调用", color="#A68CFF"];
  d5d -> d6d [label="受控变更", color="#A68CFF"];
  d6c -> d7a [label="对象/事件", color="#5CD6E6"];
  d7b -> d4a [label="历史先验", color="#5CD6E6", style=dashed, constraint=false];

  // Research and industry anchors, kept as leaf entities to avoid layout collisions.
  case [label="论文 / 工业案例锚点\nMinder · ByteRobust · StriaTrace · Mint\nNeutrino · FLARE · Aegis · AgentChaos\nCOLA · iPACK · Oasis · Antithesis · Clockwork", shape=note, style="filled,dashed", fillcolor="#251B37", color="#D1A8FF", fontcolor="#E2C8FF", fontsize=14];
  d2d -> case [label="案例", color="#D1A8FF", style=dashed, constraint=false];
  d4d -> case [color="#D1A8FF", style=dashed, constraint=false];
  d5d -> case [color="#D1A8FF", style=dashed, constraint=false];
  d6e -> case [color="#D1A8FF", style=dashed, constraint=false];
  d7d -> case [color="#D1A8FF", style=dashed, constraint=false];
}
